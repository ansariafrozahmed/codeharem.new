# Supabase (Project Settings → API keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare R2 (R2 → Manage API tokens → Object Read & Write for one bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket: the r2.dev URL or your custom domain, no trailing slash
R2_PUBLIC_URL=

# This site's own public URL, no trailing slash.
# Used for sign-in redirects, canonical links, sitemap, robots.txt and share images.
# Local: http://localhost:3000   Production: https://yourdomain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000
